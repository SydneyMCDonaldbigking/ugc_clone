{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "script/v1",
  "title": "English structure-mode script",
  "type": "object",
  "required": ["schema", "language", "mode", "variant_id", "lines"],
  "properties": {
    "schema": {"const": "script/v1"},
    "language": {"type": "string", "pattern": "^en(?:-|$)"},
    "mode": {"const": "structure"},
    "variant_id": {"type": "string", "minLength": 1},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "segment", "beats", "text", "claims", "target_duration_seconds", "delivery"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "segment": {"type": "integer", "minimum": 1},
          "beats": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "text": {"type": "string", "minLength": 1},
          "claims": {"type": "array", "items": {"type": "string"}},
          "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "delivery": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "additionalProperties": true
}
