{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keyframe-qc/v1",
  "title": "Codex visual inspection gate for keyframes",
  "type": "object",
  "required": ["schema", "job", "pipeline_job_id", "variant_id", "source_analysis", "result", "segments", "reviewed_by"],
  "properties": {
    "schema": {"const": "keyframe-qc/v1"},
    "result": {"enum": ["pass", "failed"]},
    "scene_consistency": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["result", "keyframes", "scene_views", "variation_policy", "hard_match_fields", "soft_guide_fields"],
        "properties": {
          "result": {"const": "pass"},
          "keyframes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "scene_views": {"const": ["eye_level", "oblique_45", "overhead_90"]},
          "variation_policy": {"const": "closeup_flexible"},
          "hard_match_fields": {"const": ["surface"]},
          "soft_guide_fields": {"const": ["setting", "backdrop", "lighting", "palette", "fixed_props"]}
        },
        "additionalProperties": true
      }
    },
    "segments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["file", "width", "height", "sha256", "checks"],
        "properties": {
          "file": {"type": "string", "pattern": "^seg.*\\.png$"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "reviewed_by": {"const": "codex"}
  },
  "additionalProperties": true
}
