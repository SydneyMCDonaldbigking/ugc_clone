{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keyframe-qc/v1",
  "title": "Codex visual inspection gate for keyframes",
  "type": "object",
  "required": ["schema", "job", "pipeline_job_id", "variant_id", "source_analysis", "result", "segments", "reviewed_by"],
  "properties": {
    "schema": {"const": "keyframe-qc/v1"},
    "result": {"enum": ["pass", "failed"]},
    "segments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["file", "width", "height", "sha256", "checks"],
        "properties": {
          "file": {"type": "string", "pattern": "^seg.*\\.png$"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "reviewed_by": {"const": "codex"}
  },
  "additionalProperties": true
}
