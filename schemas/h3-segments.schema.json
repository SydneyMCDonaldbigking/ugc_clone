{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h3-segments/v1",
  "title": "Deterministically compiled H3 submission segments",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "duration",
      "source_start_seconds",
      "source_end_seconds",
      "trim_to_seconds",
      "prompt",
      "images"
    ],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "duration": {"type": "number", "minimum": 2, "maximum": 15},
      "source_start_seconds": {"type": "number", "minimum": 0},
      "source_end_seconds": {"type": "number", "exclusiveMinimum": 0},
      "trim_to_seconds": {"type": "number", "exclusiveMinimum": 0},
      "prompt": {"type": "string", "minLength": 1},
      "images": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "additionalProperties": false
  }
}
