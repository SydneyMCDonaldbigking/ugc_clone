{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shot-plan/v1",
  "title": "English shot plan",
  "type": "object",
  "required": ["schema", "language", "variant_id", "segments"],
  "properties": {
    "schema": {"const": "shot-plan/v1"},
    "language": {"type": "string", "pattern": "^en(?:-|$)"},
    "variant_id": {"type": "string", "minLength": 1},
    "audio_mode": {"enum": ["dialogue", "silent"]},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "segment",
          "duration_seconds",
          "dialogue",
          "shot_type",
          "subject",
          "action",
          "performance",
          "keyframe_ids",
          "continuity",
          "keyframe_strategy",
          "references",
          "preserve",
          "exclude",
          "label_policy"
        ],
        "properties": {
          "performance": {"type": "string", "minLength": 1},
          "keyframe_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "additionalProperties": true
}
