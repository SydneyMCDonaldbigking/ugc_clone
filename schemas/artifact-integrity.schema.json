{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-integrity/v1",
  "title": "Sealed local render-input integrity snapshot",
  "type": "object",
  "required": ["schema", "digest", "files"],
  "properties": {
    "schema": {"const": "artifact-integrity/v1"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": false
}
