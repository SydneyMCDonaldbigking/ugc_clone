{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ugc-job/v1",
  "title": "English UGC job",
  "type": "object",
  "required": [
    "schema",
    "job_id",
    "reference_video",
    "source_language",
    "target_language",
    "mode",
    "variants",
    "segment_duration_seconds",
    "max_segments_per_render",
    "product",
    "beats",
    "script",
    "shot_plan",
    "keyframe_request",
    "state_file",
    "events_file",
    "image_provider",
    "video_provider",
    "human_review_required"
  ],
  "properties": {
    "schema": {"const": "ugc-job/v1"},
    "job_id": {"type": "string", "minLength": 1},
    "reference_video": {"type": "string", "minLength": 1},
    "source_language": {"type": "string", "minLength": 1},
    "target_language": {"type": "string", "pattern": "^en(?:-|$)"},
    "mode": {"const": "structure"},
    "variants": {"type": "integer", "minimum": 1},
    "segment_duration_seconds": {"type": "number", "minimum": 1, "maximum": 10},
    "max_segments_per_render": {"type": "integer", "minimum": 1, "maximum": 4},
    "product": {"type": "string", "minLength": 1},
    "beats": {"type": "string", "minLength": 1},
    "script": {"type": "string", "minLength": 1},
    "shot_plan": {"type": "string", "minLength": 1},
    "keyframe_request": {"type": "string", "minLength": 1},
    "state_file": {"type": "string", "minLength": 1},
    "events_file": {"type": "string", "minLength": 1},
    "image_provider": {"const": "codex-imagegen"},
    "video_provider": {"const": "h3"},
    "human_review_required": {"const": true}
  },
  "additionalProperties": true
}
