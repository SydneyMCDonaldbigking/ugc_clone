{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product/v1",
  "title": "Evidence-backed English product",
  "type": "object",
  "required": ["schema", "language", "name", "brand", "visual_identity", "facts", "forbidden_claims", "visual_assets"],
  "properties": {
    "schema": {"const": "product/v1"},
    "language": {"type": "string", "pattern": "^en(?:-|$)"},
    "name": {"type": "string", "minLength": 1},
    "brand": {"type": "string", "minLength": 1},
    "visual_identity": {
      "type": "object",
      "required": ["packaging_type", "silhouette", "closure", "grip_geometry", "handle", "front_label", "back_label", "forbidden_features"],
      "properties": {
        "handle": {"type": "string", "minLength": 1},
        "forbidden_features": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "evidence", "evidence_type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "evidence_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "forbidden_claims": {"type": "array", "items": {"type": "string"}},
    "visual_assets": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
